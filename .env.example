# --- Database ---
POSTGRES_USER=inboxa
POSTGRES_PASSWORD=your-password-here
POSTGRES_DB=inboxa

# --- General ---
TIMEZONE=Asia/Karachi

# --- AI model ---
# Pick one provider: ollama | gemini | groq | openai | anthropic
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=your GOOGLE_API_KEY
EMBED_MODEL=nomic-embed-text

# Ollama running in Docker (docker compose --profile local-ai up -d)
OLLAMA_BASE_URL=http://ollama:11434
# Ollama installed directly on your computer instead? Use this line:
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# API keys — fill in only the one you use
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Integrations (filled in during Phase 3) ---
SLACK_WEBHOOK_URL=
HUBSPOT_ACCESS_TOKEN=
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
